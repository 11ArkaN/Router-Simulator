{
  "name": "router-simulator",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "build": "pnpm core:publish && pnpm --filter @router-simulator/web build",
    "prebuild": "pnpm info:check",
    "dev": "pnpm --filter @router-simulator/web dev",
    "toolchain:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-toolchain.ps1",
    "dependencies:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-dependencies.ps1",
    "core:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 build",
    "core:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 test",
    "core:manual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 manual",
    "core:benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 benchmark",
    "core:runtime-benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 runtime-benchmark",
    "core:runtime-benchmark:cached": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 runtime-benchmark -SkipBuild",
    "core:structure-benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 structure-benchmark",
    "core:structure-benchmark:cached": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 structure-benchmark -SkipBuild",
    "benchmark:check": "node tools/check-benchmark.mjs",
    "core:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 publish",
    "core:publish:cached": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/core.ps1 publish -SkipBuild",
    "sources:validate": "node tools/validate-sources.mjs",
    "profiles:generate": "node tools/generate-profile.mjs && node tools/generate-device-catalog.mjs && node tools/generate-dnssec-policy.mjs",
    "profiles:check": "node tools/generate-profile.mjs --check && node tools/generate-device-catalog.mjs --check && node tools/generate-dnssec-policy.mjs --check",
    "architecture:check": "node tools/check-dependencies.mjs",
    "public-release:check": "node tools/check-public-release.mjs",
    "notices:generate": "node tools/generate-third-party-notices.mjs",
    "notices:check": "node tools/generate-third-party-notices.mjs --check",
    "test": "pnpm core:test && pnpm -r test",
    "pretest": "pnpm info:check",
    "info:check": "node tools/check-info-renderers.mjs",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm sources:validate && pnpm profiles:check && pnpm architecture:check && pnpm public-release:check && pnpm notices:check && pnpm typecheck && pnpm test && pnpm benchmark:check && pnpm core:structure-benchmark:cached && pnpm core:runtime-benchmark:cached && pnpm core:publish:cached && pnpm --filter @router-simulator/web build"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
